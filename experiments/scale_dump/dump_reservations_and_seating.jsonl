{"c": "podium", "d": "reception desk where reservations are managed"}
{"c": "buzzer_system", "d": "paging device alerting waiting guests their table is ready"}
{"c": "pager", "d": "handheld device given to guests on waitlist"}
{"c": "phone_reservation", "d": "booking made via telephone call"}
{"c": "online_booking", "d": "reservation made through restaurant website or app"}
{"c": "third_party_reservation", "d": "booking through external platforms like OpenTable or Resy"}
{"c": "standing_room", "d": "area where guests can be seated without fixed chairs"}
{"c": "bar_seating", "d": "stool seating at the bar counter area"}
{"c": "counter_seating", "d": "seats at a service or display counter"}
{"c": "booth", "d": "enclosed table seating with high back cushions"}
