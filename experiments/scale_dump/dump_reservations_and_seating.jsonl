{"c": "communal_table", "d": "large shared table seating multiple unconnected parties"}
{"c": "window_table", "d": "table positioned near exterior windows"}
{"c": "outdoor_seating", "d": "patio or terrace dining area outside the building"}
{"c": "rooftop_seating", "d": "dining area located on the roof of the establishment"}
