{"c": "reservation", "d": "advance booking to secure a table at a specific date and time"}
{"c": "walk_in", "d": "guest arriving without a prior booking"}
{"c": "waitlist", "d": "list of guests awaiting an available table"}
{"c": "table_allocation", "d": "process of assigning tables to arriving guests"}
{"c": "seating_chart", "d": "visual diagram showing table positions and numbers"}
{"c": "reservation_system", "d": "software or platform managing booking operations"}
{"c": "booking_confirmation", "d": "communication confirming a reservation was made"}
{"c": "cancellation_policy", "d": "rules governing how reservations can be canceled"}
{"c": "no_show", "d": "guest with reservation who fails to arrive"}
{"c": "overbooking", "d": "accepting more reservations than available seating capacity"}
{"c": "table_turnover", "d": "rate at which tables become available for new guests"}
{"c": "seating_capacity", "d": "total number of seats available in the restaurant"}
{"c": "party_size", "d": "number of guests in a dining group"}
{"c": "time_slot", "d": "specific reserved time block for dining"}
{"c": "peak_hours", "d": "busiest dining periods with highest demand"}
{"c": "off_peak", "d": "quieter periods with lower reservation demand"}
